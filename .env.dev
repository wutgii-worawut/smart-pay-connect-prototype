# .env.dev — ค่า env สำหรับ DEV บน Vercel (§18) — โหลดเมื่อ build ด้วย `--mode dev`
# (build DEV ใช้ `npm run build:dev` — ไม่งั้นจะได้ค่า .env.production)
# ⚠️ ใส่ได้เฉพาะ VITE_* (public config — baked เข้า bundle ฝั่ง client, ไม่ใช่ความลับ §18)
#    ห้ามใส่ secret/JWT/API key ที่นี่. Endpoint URL ของ LIFF app = โดเมน Vercel DEV (§12.1/§18.1)

# --- LIFF (§13, §18.1) ---
# 🔴 ต้องกรอกก่อน deploy: LIFF ID จริงของ DEV channel (สร้างใน LINE Developers Console)
#    endpoint URL ของ LIFF app ตั้งเป็นโดเมน Vercel DEV; แต่ละ env (dev/uat/prd) มี LIFF ID แยก
VITE_LIFF_ID="2010790317-Tpvn4gUt"

# LIFF จริงบนเครื่อง (ไม่ mock) — DEV มีไว้ทดสอบใน LINE จริงตาม checklist §21.4
# (ต้องมี VITE_LIFF_ID จริงด้านบนก่อน ไม่งั้น LIFF init ไม่ผ่าน)
VITE_LIFF_MOCK=false

# --- API (§16) ---
# ชี้ hosted mock service (ngrok, plan.md §1.5 + memory mock-service-api) — ยิงผ่านเน็ตจริง
# ⚠️ ngrok free สุ่มโดเมนใหม่ทุกครั้งที่ tunnel restart — ถ้า login ติด NETWORK_ERROR ให้เช็คว่า URL นี้
#    ยัง live ไหม (เปลี่ยนเป็นโดเมนปัจจุบัน). api-client ใส่ header ngrok-skip-browser-warning ให้เอง
#    เมื่อ backend DEV จริงพร้อม → เปลี่ยนเป็น URL backend
VITE_API_URL=https://infeasible-subcandidly-judie.ngrok-free.dev

# ⚠️ MSW ใช้ใน LINE LIFF ไม่ได้ (webview ไม่รองรับ Service Worker — iOS WKWebView) → ต้อง false
#    แล้วยิง VITE_API_URL ผ่านเน็ตจริง. MSW ใช้ได้เฉพาะ local dev (`.env.development`, เบราว์เซอร์ปกติ)
VITE_API_MOCK=false

# --- Register (feature-plans/01 §1.2, P9) ---
# 'form' | 'thaid' | 'both' — 'both' = จอ 1.1 เต็ม (ฟอร์ม + ปุ่ม ThaID)
# ⚠️ ห้ามตั้ง 'thaid' จนกว่า ThaID OAuth จะเคาะ+ทำ (Open Q §23 — 'thaid' = จอตัน ปุ่มแค่ toast)
VITE_REGISTER_MODE=both

# VITE_ALLOWED_EMAIL_DOMAIN: จงใจไม่ตั้ง — โดเมนอีเมลองค์กรจริงยังไม่ยืนยัน (Open Q §23 feature-plans/01)
# เมื่อเคาะโดเมนแล้วค่อยตั้ง เช่น: VITE_ALLOWED_EMAIL_DOMAIN=ap.go.th
