{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(npx tsc --noEmit)",
      "Bash(npm run dev:*)"
    ],
    "deny": [
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(.env.uat)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)"
    ]
  }
}
